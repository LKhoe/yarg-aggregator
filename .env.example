# ============================================
# YARG Aggregator - Environment Variables
# ============================================

# Raspberry Pi deployment (used by deploy.sh)
PI_HOST=
PI_USER=
PI_PORT=22

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yarg_db
# Postgres credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yarg_db

# BetterAuth Configuration
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
# Base URL of your application (used for callbacks)
BETTER_AUTH_URL=http://localhost:3000

# Next.js Configuration
# Public base URL (accessible in client-side code)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Environment (development, production, test)
NODE_ENV=production

# Google Site Verification
GOOGLE_SITE_VERIFICATION=

# Social OAuth Providers
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Spotify OAuth: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Sign in with Apple (optional): https://developer.apple.com
# APPLE_CLIENT_ID is the Service ID (e.g. com.example.web)
# APPLE_TEAM_ID is your 10-char Apple Team ID
# APPLE_KEY_ID and APPLE_PRIVATE_KEY are for the Auth key (Sign in with Apple capability)
# The client secret JWT is generated automatically from these keys at server startup.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Apple Music import (optional): https://developer.apple.com/documentation/applemusicapi
# APPLE_MUSIC_KEY_ID and APPLE_MUSIC_PRIVATE_KEY are for the MusicKit key
# (different key from the Auth key above, registered with MusicKit capability)
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

# Last.fm API: https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Music Platform APIs (optional)
# YouTube Data API v3: https://console.cloud.google.com
YOUTUBE_API_KEY=
# SoundCloud: https://developers.soundcloud.com
SOUNDCLOUD_CLIENT_ID=

# OpenRouter
OPENROUTER_API_KEY=
