# ============================================
# YARG Aggregator - Environment Variables
# ============================================

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yarg_db
# Postgres credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yarg_db

# BetterAuth Configuration
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
# Base URL of your application (used for callbacks)
BETTER_AUTH_URL=http://localhost:3000

# Next.js Configuration
# Public base URL (accessible in client-side code)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Environment (development, production, test)
NODE_ENV=production

# Social OAuth Providers
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Music Platform APIs (optional)
# Spotify: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# YouTube Data API v3: https://console.cloud.google.com
YOUTUBE_API_KEY=
# SoundCloud: https://developers.soundcloud.com
SOUNDCLOUD_CLIENT_ID=
